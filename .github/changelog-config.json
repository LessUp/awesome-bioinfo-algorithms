{
    "categories": [
        {"title": "## 🚀 Features", "labels": ["feature", "enhancement", "new-algorithm"]},
        {"title": "## 🐛 Fixes", "labels": ["fix", "bug"]},
        {"title": "## 📚 Documentation", "labels": ["docs", "documentation"]},
        {"title": "## 🔧 Maintenance", "labels": ["chore", "maintenance", "refactor"]},
        {"title": "## 📦 Dependencies", "labels": ["dependencies"]},
    ],
    "ignore_labels": ["ignore-for-release"],
    "sort": {"order": "ASC", "on_property": "mergedAt"},
    "template": "${{CHANGELOG}}\n\n## 📊 Stats\n\n**Full Changelog**: ${{RELEASE_DIFF}}",
    "pr_template": "- ${{TITLE}} by @${{AUTHOR}} in #${{NUMBER}}",
}
